{
  "name": "fintrack-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build",
